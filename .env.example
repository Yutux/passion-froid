# Copier ce fichier vers .env et renseigner vos propres identifiants.
# Ne jamais committer .env ni le fichier de compte de service Firebase.

# Django : générer une clé aléatoire stable avant de démarrer.
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Cloudinary : architecture Bronze / Silver / Gold
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase : configuration de votre propre projet
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_MEDIA_COLLECTION=media_assets
# Chemin local vers le JSON secret, exclu de Git.
FIREBASE_CREDENTIALS_PATH=

# Hugging Face : inférence distante soumise aux quotas du fournisseur.
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_API_TIMEOUT=45
HUGGINGFACE_VISION_PROVIDER=auto
HUGGINGFACE_VISION_INSTRUCT_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# Liste optionnelle model:provider séparée par des virgules ; vide = choix du moteur.
HUGGINGFACE_VISION_INSTRUCT_MODELS=
HUGGINGFACE_BLIP_MODEL=Salesforce/blip-image-captioning-large
# URL d'un endpoint dédié si disponible.
HUGGINGFACE_BLIP_ENDPOINT=
HUGGINGFACE_OBJECT_DETECTION_MODEL=facebook/detr-resnet-50
HUGGINGFACE_OBJECT_ENDPOINT=
HUGGINGFACE_TRANSLATION_MODEL=Qwen/Qwen3-8B:nscale
HUGGINGFACE_SEARCH_MODEL=intfloat/multilingual-e5-large
HUGGINGFACE_SEARCH_ENABLED=true
HUGGINGFACE_SPEECH_MODEL=openai/whisper-large-v3
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
HUGGINGFACE_OCR_MODEL=microsoft/trocr-base-printed
HUGGINGFACE_VIDEO_MODEL=MCG-NJU/videomae-base

# Le worker intégré nécessite que le serveur de développement reste actif.
AI_WORKER_ENABLED=true
PASSIONFROID_AUTO_SYNC_ON_STARTUP=true
PASSIONFROID_AUTO_SYNC_SKIP_AI=false
